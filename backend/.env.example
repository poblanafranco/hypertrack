# Copia este archivo a .env  (ya viene un .env listo para desarrollo)
#
# El puerto 5433 es el de la base que levanta Docker (docker compose up -d db).
# Se usa 5433 a propósito para NO chocar con un PostgreSQL instalado en Windows (que usa el 5432).
DATABASE_URL="postgresql://hypertrack:hypertrack@localhost:5433/hypertrack?schema=public"
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
PORT=4000
# Varios orígenes separados por coma
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
