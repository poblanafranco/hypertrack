# Normalmente NO necesitas este archivo.
# En desarrollo, Vite redirige /api al backend (http://localhost:4000).
# Solo si tu backend corre en otro lugar, descomenta y ajusta:
# VITE_PROXY_TARGET=http://localhost:4000
#
# Solo si sirves el frontend y la API en dominios distintos (producción sin proxy):
# VITE_API_URL=https://api.midominio.com/api
